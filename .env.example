# Never commit .env.local or credentials. Set server variables in Netlify.
# Use Builds + Functions scopes where available; Free plans require All scopes.
CATALOG_SOURCE=demo
APP_URL=http://localhost:3000
READING_ENABLED=false
# Activate sharepoint only after the list has approved PUBLIC metadata.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Generate locally: openssl rand -hex 32. Never send this value in chat.
SESSION_SECRET=
# Entra user app role required for reading; assign only eligible university members.
ENTRA_READER_ROLE=Theses.Reader
SHAREPOINT_SITE_ID=
SHAREPOINT_CATALOG_LIST_ID=
# e.g. university.sharepoint.com (no scheme/path)
SHAREPOINT_READING_HOST=
